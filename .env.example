# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.
# EXPO_PUBLIC_ 접두사가 붙은 값은 클라이언트 번들에 포함된다 — 비밀 값을 넣지 말 것.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google Cloud Console > 사용자 인증 정보 > OAuth 클라이언트 ID
# 반드시 **웹 애플리케이션** 유형이어야 한다. iOS/Android 유형이 아니다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-yyyy.apps.googleusercontent.com

# ⚠ iOS 클라이언트 ID를 바꾸면 app.json의 google-signin 플러그인
#   iosUrlScheme도 함께 고쳐야 한다 (역방향 형식):
#     com.googleusercontent.apps.<위 iOS ID에서 .apps.googleusercontent.com 뗀 부분>
#   빠지면 로그인 후 앱으로 돌아오지 못하고 조용히 실패한다.

# 초대 링크 도메인. Universal Link / App Link 설정과 일치해야 한다.
EXPO_PUBLIC_INVITE_BASE_URL=https://familyshare.example.com/invite

# --- 아래는 Edge Function 전용 (Supabase 대시보드의 Secrets에 넣고, 이 파일에는 두지 않는다) ---
# GOOGLE_CLIENT_ID=                  # 위 EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID와 같은 웹 클라이언트 ID
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=               # 네이티브 Google Sign-In(serverAuthCode) 플로우에서는
#                                    # 불필요하다. 비워둬라. 값을 넣으면 tokens.ts가
#                                    # 코드 교환 요청에 redirect_uri를 붙이고, 구글에
#                                    # 등록된 값과 다르면 redirect_uri_mismatch가 난다.
# FCM_SERVICE_ACCOUNT_JSON=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY=                  # Apple .p8 개인 키 전체 PEM
# APNS_USE_SANDBOX=false
# DOWNLOAD_TICKET_SIGNING_KEY=
# NOTIFY_WEBHOOK_SECRET=             # DB Webhook/Scheduled Function의 x-webhook-secret
